# ========================================================
# ScanAI Platform — Environment Configuration (Template)
# ========================================================

# OpenAI Configuration
# Dashboard: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Anthropic Claude Configuration
# Dashboard: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Configuration
# Dashboard: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash

# MongoDB Atlas Database Configuration
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
# Local fallback: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB_NAME=scanai

# Application & Session Secrets
SESSION_SECRET=
PUBLIC_APP_URL=http://localhost:5173

# Optional Transactional Email (Resend)
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=ScanAI <onboarding@resend.dev>
